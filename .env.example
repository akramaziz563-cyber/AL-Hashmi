# GEMINI_API_KEY: Required for Gemini AI API calls (Maps Grounding & Image Studio).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OWNER_EMAIL: Destination email address for new property & general inquiry notifications.
OWNER_EMAIL=

# RESEND_API_KEY: Optional Resend API key for outbound inquiry email notifications.
RESEND_API_KEY=

# SMTP Configuration (Optional alternative to Resend for Nodemailer)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
